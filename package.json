{
  "name": "@datex2/dx-type",
  "version": "0.1.0",
  "description": "DATEx2 Web Components: Typewriter, Reveal, Number & Odometer scroll-driven animations",
  "author": "Laurențiu Macovei <DATEx2.bike@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/DATEx2/dx-type.git"
  },
  "homepage": "https://github.com/DATEx2/dx-type#readme",
  "bugs": {
    "url": "https://github.com/DATEx2/dx-type/issues"
  },
  "keywords": [
    "web-components",
    "typewriter",
    "scroll-driven-animations",
    "SDA",
    "reveal",
    "odometer",
    "counter",
    "css-animations",
    "custom-elements",
    "datex2"
  ],
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "dist/css/*",
    "src/css/*"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js",
      "default": "./dist/client.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js",
      "default": "./dist/server.js"
    },
    "./css": "./dist/css/dx-type.css",
    "./css/min": "./dist/css/dx-type.min.css",
    "./css/*": "./dist/css/*.css"
  },
  "files": [
    "dist/",
    "src/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node build.js",
    "watch": "node build.js --watch",
    "prepublishOnly": "npm run build && npm test",
    "test": "node tests/run-tests.js"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "gif-encoder-2": "^1.0.5",
    "omggif": "^1.0.10",
    "pngjs": "^7.0.0",
    "puppeteer": "^25.8.0",
    "sharp": "^0.35.3"
  }
}
